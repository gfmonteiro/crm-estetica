    CLIENTS {
        uuid id PK
        uuid organization_id FK
        string nome
        string telefone
        string whatsapp
        string email
        string cpf_encrypted
        date data_nascimento
        string sexo
        string origem
        string status
        timestamp deleted_at
        timestamp created_at
    }

    APPOINTMENTS {
        uuid id PK
        uuid organization_id FK
        uuid unit_id FK
        uuid client_id FK
        uuid procedure_id FK
        uuid professional_id FK
        timestamp start_at
        timestamp end_at
        string status
        boolean is_waitlist
        timestamp created_at
    }

    PROCEDURES {
        uuid id PK
        uuid organization_id FK
        string nome
        decimal valor
        int tempo_medio_min
        decimal comissao_percentual
        text descricao
    }

    FINANCIAL_TRANSACTIONS {
        uuid id PK
        uuid organization_id FK
        uuid client_id FK
        uuid category_id FK
        decimal valor
        string tipo
        string metodo_pagamento
        string status
        timestamp data
    }

    LEADS {
        uuid id PK
        uuid organization_id FK
        uuid client_id FK
        uuid stage_id FK
        string origem
        timestamp created_at
    }

    USERS {
        uuid id PK
        uuid organization_id FK
        uuid unit_id FK
        uuid role_id FK
        string nome
        string email
        string password_hash
        boolean two_factor_enabled
    }
